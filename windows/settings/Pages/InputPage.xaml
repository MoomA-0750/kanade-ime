<Page
    x:Class="Kanade.Settings.Pages.InputPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Kanade.Settings"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls">
    <ScrollViewer>
        <StackPanel Margin="36,24,36,36" MaxWidth="1000" Spacing="{StaticResource SettingsCardSpacing}">
            <TextBlock Text="{local:L Ja='入力', En='Input'}" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,12" />

            <TextBlock Text="{local:L Ja='変換', En='Conversion'}" Style="{StaticResource SectionHeader}" />
            <tk:SettingsCard Header="{local:L Ja='ライブ変換', En='Live conversion'}"
                             Description="{local:L Ja='打つたびに変換した結果を出します。切ると Space を押すまでかなのままです', En='Shows the converted text as you type. When off, text stays in kana until you press Space'}">
                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8D2;" /></tk:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="Live" Toggled="OnChanged" OnContent="{local:L Ja='オン', En='On'}" OffContent="{local:L Ja='オフ', En='Off'}" />
            </tk:SettingsCard>
            <tk:SettingsCard Header="{local:L Ja='数字・記号を全角にする', En='Full-width numbers and symbols'}"
                             Description="{local:L Ja='日本語入力中の数字・記号・大文字を全角で入れます（Space は半角のまま）', En='Types numbers, symbols and capital letters in full width while Japanese input is on (Space stays half width)'}">
                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8E9;" /></tk:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="FullWidth" Toggled="OnChanged" OnContent="{local:L Ja='オン', En='On'}" OffContent="{local:L Ja='オフ', En='Off'}" />
            </tk:SettingsCard>
            <tk:SettingsCard Header="{local:L Ja='句読点', En='Punctuation'}" Description="{local:L Ja='「,」と「.」で入る句読点です', En='The marks typed with the comma and period keys'}">
                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8C1;" /></tk:SettingsCard.HeaderIcon>
                <ComboBox x:Name="Punctuation" SelectionChanged="OnChanged" MinWidth="120">
                    <x:String>、。</x:String>
                    <x:String>，．</x:String>
                    <x:String>、．</x:String>
                    <x:String>，。</x:String>
                </ComboBox>
            </tk:SettingsCard>
            <tk:SettingsCard Header="{local:L Ja='括弧を対で入れる', En='Insert brackets in pairs'}"
                             Description="{local:L Ja='開き括弧を打つと閉じ括弧も入れ、カーソルを中に置きます。空の括弧で Space を押すと括弧の種類が替わります', En='Typing an opening bracket also inserts the closing one and puts the cursor between them. Press Space in empty brackets to change their kind'}">
                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE943;" /></tk:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="Brackets" Toggled="OnChanged" OnContent="{local:L Ja='オン', En='On'}" OffContent="{local:L Ja='オフ', En='Off'}" />
            </tk:SettingsCard>

            <TextBlock Text="{local:L Ja='日本語のオン/オフ', En='Turning Japanese on and off'}" Style="{StaticResource SectionHeader}" />
            <tk:SettingsExpander Header="{local:L Ja='切り替えに使うキー', En='Keys to switch'}"
                                 Description="{local:L Ja='変換（オン）・無変換（オフ）・半角/全角はいつでも使えます', En='Henkan (on), Muhenkan (off) and Hankaku/Zenkaku always work'}" IsExpanded="True">
                <tk:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE765;" /></tk:SettingsExpander.HeaderIcon>
                <tk:SettingsExpander.Items>
                    <tk:SettingsCard Header="{local:L Ja='右 Alt の単押し', En='Tap Right Alt'}" Description="{local:L Ja='US 配列で右 Alt だけを押して離す', En='Press and release only Right Alt (US layout)'}">
                        <ToggleSwitch x:Name="RightAlt" Toggled="OnChanged" OnContent="{local:L Ja='オン', En='On'}" OffContent="{local:L Ja='オフ', En='Off'}" />
                    </tk:SettingsCard>
                    <tk:SettingsCard Header="Ctrl+Space">
                        <ToggleSwitch x:Name="CtrlSpace" Toggled="OnChanged" OnContent="{local:L Ja='オン', En='On'}" OffContent="{local:L Ja='オフ', En='Off'}" />
                    </tk:SettingsCard>
                    <tk:SettingsCard Header="F13" Description="{local:L Ja='QMK などのキーボードから送る専用のキー', En='A dedicated key sent from keyboards such as QMK'}">
                        <ToggleSwitch x:Name="F13" Toggled="OnChanged" OnContent="{local:L Ja='オン', En='On'}" OffContent="{local:L Ja='オフ', En='Off'}" />
                    </tk:SettingsCard>
                </tk:SettingsExpander.Items>
            </tk:SettingsExpander>

            <TextBlock Text="{local:L Ja='学習', En='Learning'}" Style="{StaticResource SectionHeader}" />
            <tk:SettingsCard Header="{local:L Ja='選んだ変換を覚える', En='Remember chosen conversions'}"
                             Description="{local:L Ja='候補から選んで確定したものを、次から先に出します', En='Candidates you pick are shown first next time'}">
                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE81C;" /></tk:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="Learning" Toggled="OnChanged" OnContent="{local:L Ja='オン', En='On'}" OffContent="{local:L Ja='オフ', En='Off'}" />
            </tk:SettingsCard>
            <tk:SettingsCard Header="{local:L Ja='覚えたものを消す', En='Clear learned conversions'}"
                             Description="{local:L Ja='学習した変換をすべて消します（ユーザー辞書は消えません）', En='Deletes everything learned (your user dictionary is kept)'}">
                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE74D;" /></tk:SettingsCard.HeaderIcon>
                <Button Content="{local:L Ja='消す', En='Clear'}" Click="OnClearLearning" />
            </tk:SettingsCard>

            <TextBlock Text="{local:L Ja='表示', En='Display'}" Style="{StaticResource SectionHeader}" />
            <tk:SettingsCard Header="{local:L Ja='表示の言語（Language）', En='Language（表示の言語）'}"
                             Description="{local:L Ja='設定の画面・タスクバーのメニューなどの言語です', En='The language of this window, the taskbar menu and other messages'}">
                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE774;" /></tk:SettingsCard.HeaderIcon>
                <ComboBox x:Name="DisplayLanguage" SelectionChanged="OnLanguageChanged" MinWidth="200">
                    <ComboBoxItem Tag="auto" Content="{local:L Ja='Windows に合わせる', En='Same as Windows'}" />
                    <ComboBoxItem Tag="ja" Content="日本語" />
                    <ComboBoxItem Tag="en" Content="English" />
                </ComboBox>
            </tk:SettingsCard>
            <InfoBar x:Name="Message" IsOpen="False" Margin="0,8,0,0" />
        </StackPanel>
    </ScrollViewer>
</Page>
