<Page
    x:Class="Kanade.Settings.Pages.InputPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls">
    <ScrollViewer>
        <StackPanel Margin="36,24,36,36" MaxWidth="1000" Spacing="{StaticResource SettingsCardSpacing}">
            <TextBlock Text="入力" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,12" />

            <TextBlock Text="変換" Style="{StaticResource SectionHeader}" />
            <tk:SettingsCard Header="ライブ変換" Description="打つたびに変換した結果を出します。切ると Space を押すまでかなのままです">
                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8D2;" /></tk:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="Live" Toggled="OnChanged" OnContent="オン" OffContent="オフ" />
            </tk:SettingsCard>
            <tk:SettingsCard Header="数字・記号を全角にする" Description="日本語入力中の数字・記号・大文字を全角で入れます（Space は半角のまま）">
                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8E9;" /></tk:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="FullWidth" Toggled="OnChanged" OnContent="オン" OffContent="オフ" />
            </tk:SettingsCard>
            <tk:SettingsCard Header="句読点" Description="「,」と「.」で入る句読点です">
                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8C1;" /></tk:SettingsCard.HeaderIcon>
                <ComboBox x:Name="Punctuation" SelectionChanged="OnChanged" MinWidth="120">
                    <x:String>、。</x:String>
                    <x:String>，．</x:String>
                    <x:String>、．</x:String>
                    <x:String>，。</x:String>
                </ComboBox>
            </tk:SettingsCard>
            <tk:SettingsCard Header="括弧を対で入れる" Description="開き括弧を打つと閉じ括弧も入れ、カーソルを中に置きます。空の括弧で Space を押すと括弧の種類が替わります">
                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE943;" /></tk:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="Brackets" Toggled="OnChanged" OnContent="オン" OffContent="オフ" />
            </tk:SettingsCard>

            <TextBlock Text="日本語のオン/オフ" Style="{StaticResource SectionHeader}" />
            <tk:SettingsExpander Header="切り替えに使うキー" Description="変換（オン）・無変換（オフ）・半角/全角はいつでも使えます" IsExpanded="True">
                <tk:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE765;" /></tk:SettingsExpander.HeaderIcon>
                <tk:SettingsExpander.Items>
                    <tk:SettingsCard Header="右 Alt の単押し" Description="US 配列で右 Alt だけを押して離す">
                        <ToggleSwitch x:Name="RightAlt" Toggled="OnChanged" OnContent="オン" OffContent="オフ" />
                    </tk:SettingsCard>
                    <tk:SettingsCard Header="Ctrl+Space">
                        <ToggleSwitch x:Name="CtrlSpace" Toggled="OnChanged" OnContent="オン" OffContent="オフ" />
                    </tk:SettingsCard>
                    <tk:SettingsCard Header="F13" Description="QMK などのキーボードから送る専用のキー">
                        <ToggleSwitch x:Name="F13" Toggled="OnChanged" OnContent="オン" OffContent="オフ" />
                    </tk:SettingsCard>
                </tk:SettingsExpander.Items>
            </tk:SettingsExpander>

            <TextBlock Text="学習" Style="{StaticResource SectionHeader}" />
            <tk:SettingsCard Header="選んだ変換を覚える" Description="候補から選んで確定したものを、次から先に出します">
                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE81C;" /></tk:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="Learning" Toggled="OnChanged" OnContent="オン" OffContent="オフ" />
            </tk:SettingsCard>
            <tk:SettingsCard Header="覚えたものを消す" Description="学習した変換をすべて消します（ユーザー辞書は消えません）">
                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE74D;" /></tk:SettingsCard.HeaderIcon>
                <Button Content="消す" Click="OnClearLearning" />
            </tk:SettingsCard>
            <InfoBar x:Name="Message" IsOpen="False" Margin="0,8,0,0" />
        </StackPanel>
    </ScrollViewer>
</Page>
