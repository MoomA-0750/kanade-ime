<Page
    x:Class="Kanade.Settings.Pages.BackupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls">
    <ScrollViewer>
        <StackPanel Margin="36,24,36,36" MaxWidth="1000" Spacing="{StaticResource SettingsCardSpacing}">
            <TextBlock Text="読み込み・書き出し" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,12" />
            <tk:SettingsCard Header="Android 版の設定を読み込む"
                             Description="Android 版の設定画面の「設定の書き出し」で作ったファイル（kanade-settings-*.json）から、設定・ユーザー辞書・スニペットを読み込みます。今のユーザー辞書・スニペットは .bak に残します">
                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8B5;" /></tk:SettingsCard.HeaderIcon>
                <Button Content="ファイルを選ぶ" Click="OnImport" />
            </tk:SettingsCard>
            <tk:SettingsCard Header="Android 版で読める形で書き出す"
                             Description="設定・ユーザー辞書・スニペットを、Android 版の「設定の読み込み」で読める1つのファイルにします（学習は入れません）">
                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xEDE1;" /></tk:SettingsCard.HeaderIcon>
                <Button Content="書き出す" Click="OnExport" />
            </tk:SettingsCard>
            <tk:SettingsCard Header="設定のフォルダ" Description="設定・ユーザー辞書・スニペット・学習を置いているところです">
                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8B7;" /></tk:SettingsCard.HeaderIcon>
                <Button Content="開く" Click="OnOpenFolder" />
            </tk:SettingsCard>
            <tk:SettingsCard Header="記録" Description="うまく動かないときの手がかり（エンジンの記録）です">
                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE9F9;" /></tk:SettingsCard.HeaderIcon>
                <Button Content="開く" Click="OnOpenLog" />
            </tk:SettingsCard>
            <InfoBar x:Name="Message" IsOpen="False" Margin="0,8,0,0" />
        </StackPanel>
    </ScrollViewer>
</Page>
