<resources>
    <!-- Record key -->
    <string name="voice_key_section_title">Record key</string>
    <string name="voice_key_section_description">Hold the record key to record, and release it to transcribe on the device and insert the text (audio never leaves the device). A short press starts continuous listening, which inserts text each time you finish speaking (press again or stay silent for 1 minute to stop).</string>
    <string name="voice_key_label">Record key</string>
    <string name="voice_key_note_soft_keyboard">On the on-screen keyboard, use the microphone key.</string>
    <string name="voice_key_dialog_title">Record key (current: %1$s)</string>
    <string name="voice_key_dialog_note">Press a key on your physical keyboard to use it. You can also pick one from the list.</string>
    <string name="voice_close">Close</string>
    <string name="voice_cancel">Cancel</string>

    <!-- Speaking -->
    <string name="voice_speaking_section_title">Speaking</string>
    <string name="voice_streaming_title">Show text while speaking</string>
    <string name="voice_streaming_summary">Shows text while you are still speaking (with Nemotron if downloaded, otherwise ReazonSpeech).</string>
    <string name="voice_spoken_punctuation_title">Speak punctuation</string>
    <string name="voice_spoken_punctuation_summary">Say these Japanese words: くてん→。 とうてん→、 かいぎょう→new line はてなマーク→？ びっくりマーク→！ かぎかっこ／かぎかっことじ→「」 かっこ／かっことじ→（） なかぐろ→・</string>
    <string name="voice_threads_label">Recognition threads</string>

    <!-- Benchmark -->
    <string name="voice_bench_section_title">Test with a sample</string>
    <string name="voice_bench_section_description">Runs an 8.8-second Japanese sample (synthesized speech) through every downloaded model to compare time and results.</string>
    <string name="voice_bench_button">Run test</string>
    <string name="voice_bench_no_models">No models have been downloaded.</string>
    <string name="voice_bench_threads">%1$d threads (the first run includes loading time)</string>
    <string name="voice_bench_result">%1$s: %2$dms\n%3$s</string>
    <string name="voice_bench_not_recognized">(Could not recognize speech)</string>

    <!-- Models -->
    <string name="voice_models_section_title">Models</string>
    <string name="voice_models_section_description">Tap \"Apply\" to choose the model that produces the text inserted into the input field. Text shown while you speak always comes from ReazonSpeech.</string>
    <string name="voice_models_fallback_note">The applied model isn\'t downloaded, so %1$s is being used.</string>
    <string name="voice_models_none_note">No models yet. Download one to get started.</string>
