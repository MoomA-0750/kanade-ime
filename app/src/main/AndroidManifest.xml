<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 候補の帯を IME の窓ではなく重ねる窓に出すため（Galaxy では物理キーボード使用中に IME の窓が出ないことがある） -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 音声入力（押している間だけ録音し、端末内の whisper で文字にする。音声は外へ送らない） -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- モデルの取得だけに使う（ModelDownloader）。打った文字や音声は送らない -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_mode_ja"
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:supportsRtl="false">

        <service
            android:name=".KanadeInputMethodService"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:exported="true">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <activity
            android:name=".SettingsActivity"
            android:label="@string/settings_title"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
