<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 候補の帯を IME の窓ではなく重ねる窓に出すため（Galaxy では物理キーボード使用中に IME の窓が出ないことがある） -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 音声入力（押している間だけ録音し、端末内の whisper で文字にする。音声は外へ送らない） -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- モデルの取得だけに使う（ModelDownloader）。打った文字や音声は送らない -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- モデルを落とす前に Wi-Fi かを確かめる -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 「入力中の文字を帯に出すアプリ」を選ぶとき、ホーム画面に出るアプリの一覧を見る -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:localeConfig="@xml/locales_config"
        android:label="@string/app_name"
        android:icon="@drawable/ic_mode_ja"
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:supportsRtl="false">

        <service
            android:name=".KanadeInputMethodService"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:exported="true">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!-- クリップボードの履歴の画像を、貼り付け先のアプリに読ませる（外からは開けず、貼り付けのときだけ権限を渡す） -->
        <provider
            android:name=".ClipboardImageProvider"
            android:authorities="${applicationId}.clipboard"
            android:exported="false"
            android:grantUriPermissions="true" />

        <activity
            android:name=".SettingsActivity"
            android:label="@string/app_name"
            android:theme="@style/Theme.Kanade"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- クリップボードの文字を編集する画面（キーボードのクリップボードから開く。履歴に残さず、別の作業として開く） -->
        <activity
            android:name=".ClipboardEditActivity"
            android:label="@string/ime_clipboard_edit_title"
            android:theme="@style/Theme.Kanade"
            android:windowSoftInputMode="adjustResize|stateAlwaysVisible"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:exported="false" />
    </application>
</manifest>
