#!/bin/sh
# Kanade の設定の画面の入口（選び役）。GTK 版（kanade-settings-gtk）か QML 版（kanade-settings-qt）を選んで、それに置き換わる。
#   1. KANADE_UI=gtk|qt があればそれ
#   2. QML 版が入っていて、XDG_CURRENT_DESKTOP に GNOME が含まれなければ QML 版（Hyprland・Omarchy・KDE など）
#   3. それ以外は GTK 版
# 選んだ方が無ければ、もう一方を出す。引数（開くページ）はそのまま渡す
ROOT=$(cd "$(dirname "$0")/.." && pwd)
GTK="$ROOT/bin/kanade-settings-gtk"
QT="$ROOT/qt/kanade-settings-qt"

case "${KANADE_UI:-}" in
  gtk|qt) ui=$KANADE_UI ;;
  *)
    case ":$(printf '%s' "${XDG_CURRENT_DESKTOP:-}" | tr '[:lower:]' '[:upper:]'):" in
      *GNOME*) ui=gtk ;;
      *) if [ -x "$QT" ]; then ui=qt; else ui=gtk; fi ;;
    esac ;;
esac

if [ "$ui" = qt ] && [ -x "$QT" ]; then exec "$QT" "$@"; fi
if [ -x "$GTK" ]; then exec "$GTK" "$@"; fi
if [ -x "$QT" ]; then exec "$QT" "$@"; fi
echo "Kanade の設定の画面が入っていません（$ROOT）" >&2
exit 1
